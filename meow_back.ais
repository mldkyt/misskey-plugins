/// @ 0.12.4
### {
  name: "meow back"
  version: "1.0.2"
  author: "mldchan"
  description: "This is a plugin that allows you to quickly meow back at cats"
  permissions: ["write:notes"]
}

Plugin:register_note_action('Meow at this user :3', @(note) {

	var meow = `mraw`
	let arr = ["a", "w", "r"]
	for (Math:rnd(10, 30)) {
		meow = `{meow}{arr[Math:rnd(0, 2)]}`
	}

	meow = `{meow} :`
	
	if (Math:rnd(1, 2) == 1) {
		for (Math:rnd(1, 5)) {
			meow = `{meow}3`
		}
	}
	else {
		meow = `{meow}3c`
	}

	var mention = ``
	if (note.user.host != null) {
		mention = `@{note.user.username}@{note.user.host}`
	} else {
		mention = `@{note.user.username}`
	}

	Mk:api("notes/create", {
		replyId: note.id,
		text: `{mention} {meow}`
	})
})