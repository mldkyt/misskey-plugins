/// @ 0.12.4
### {
  name: "🧄"
  version: "🧄"
  author: "🧄"
  description: "🧄"
  permissions: ["write:notes", "write:reactions"]
}

Plugin:register_note_action('🧄', @(note) {

	Mk:api("notes/reactions/create", {
		noteId: note.id,
		reaction: `:garlic:`
	})

	var garlic = Mk:api("notes/create", {
		renoteId: note.id,
		text: `:garlic: #garlic #🧄`
	})

	var garlic2 = Mk:api("notes/create", {
		replyId: note.id,
		text: `:garlic: #garlic #🧄`
	})

  Mk:api("notes/reactions/create", {
    noteId: garlic.createdNote.id,
    reaction: `:garlic:`
  })

  Mk:api("notes/reactions/create", {
    noteId: garlic2.createdNote.id,
    reaction: `:garlic:`
  })

  Mk:api("notes/create", {
    renoteId: garlic2.createdNote.id
  })

  Mk:api("notes/create", {
    renoteId: garlic.createdNote.id
  })

})
